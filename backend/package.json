{
  "name": "queuesmart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "QueueSmart REST API (Express, in-memory data)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:setup": "node scripts/dbSetup.js",
    "db:reset": "node scripts/dbSetup.js --reset"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1"
  }
}
